  "conventions": {
    "exe": "expected_cmdline is lpCommandLine for CreateProcessW with lpApplicationName = resolved absolute path of argv[0]. expected_reparse_crt is argv as parsed by the UCRT startup code (post-2008 rules); for every exe vector the pre-2008 msvcrt rule and CommandLineToArgvW give the same result because the encoder never emits a doubled quote and never starts with whitespace.",
    "bat": "expected_cmdline is lpCommandLine; lpApplicationName = %SystemRoot%\\System32\\cmd.exe. argv[0] is the resolved script path. expected_reparse_via_shim_forwarding is argv[1:] seen by a UCRT program when the batch file forwards %* verbatim (the npm.cmd/yarn.cmd shim pattern), under a simplified model of cmd.exe phase-1 percent expansion; it is NOT what %~1 inside the batch yields for args containing quotes.",
    "argv_generator": "when present, argv[index] is replaced by char*count before encoding",
    "argv_hex": "when present, argv[i] is the raw byte string given in hex (non-UTF-8 input)"
