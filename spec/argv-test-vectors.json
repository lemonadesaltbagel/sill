        "a;b",
        "k=v"
      ],
      "notes": ", ; = are %1 delimiters in batch argument splitting; quoting keeps them in one arg."
    },
    {
      "name": "bat_parens",
      "argv": [
        "C:\\tools\\shim.bat",
        "(x)"
      ],
      "target_kind": "bat",
      "expected_cmdline": "cmd.exe /e:ON /v:OFF /d /c \"\"C:\\tools\\shim.bat\" \"(x)\"\"",
      "lpApplicationName": "%SystemRoot%\\System32\\cmd.exe",
      "expected_reparse_via_shim_forwarding_%*_to_ucrt_exe": [
        "(x)"
      ],
      "notes": "Parentheses quoted (they break if/for blocks inside the bat)."
    },
    {
      "name": "bat_unicode",
      "argv": [
        "C:\\tools\\shim.bat",
        "日本語"
      ],
      "target_kind": "bat",
      "expected_cmdline": "cmd.exe /e:ON /v:OFF /d /c \"\"C:\\tools\\shim.bat\" 日本語\"",
      "lpApplicationName": "%SystemRoot%\\System32\\cmd.exe",
      "expected_reparse_via_shim_forwarding_%*_to_ucrt_exe": [
        "日本語"
      ],
      "notes": "Non-ASCII not quoted; note the .bat's own code page (chcp) affects how it echoes text, not argument passing."
    },
    {
      "name": "bat_safe_chars",
      "argv": [
        "C:\\tools\\shim.bat",
        "-flag",
        "C:\\path\\file.txt",
        "a+b@c:d$e#f*g?h"
      ],
      "target_kind": "bat",
      "expected_cmdline": "cmd.exe /e:ON /v:OFF /d /c \"\"C:\\tools\\shim.bat\" -flag C:\\path\\file.txt a+b@c:d$e#f*g?h\"",
      "lpApplicationName": "%SystemRoot%\\System32\\cmd.exe",
      "expected_reparse_via_shim_forwarding_%*_to_ucrt_exe": [
        "-flag",
        "C:\\path\\file.txt",
        "a+b@c:d$e#f*g?h"
      ],
      "notes": "Safe set stays unquoted."
    },
    {
      "name": "bat_tab",
      "argv": [
        "C:\\tools\\shim.bat",
        "a\tb"
      ],
      "target_kind": "bat",
      "expected_cmdline": "cmd.exe /e:ON /v:OFF /d /c \"\"C:\\tools\\shim.bat\" \"a\tb\"\"",
      "lpApplicationName": "%SystemRoot%\\System32\\cmd.exe",
      "expected_reparse_via_shim_forwarding_%*_to_ucrt_exe": [
        "a\tb"
      ],
      "notes": "Control chars force quoting."
    },
    {
      "name": "exe_reject_nul",
      "argv": [
        "C:\\tools\\echoargs.exe",
        "a\u0000b"
      ],
      "target_kind": "exe",
      "expected_error": "NUL in argument",
      "notes": "NUL cannot be represented in a Windows command line."
    },
    {
      "name": "exe_reject_quote_in_program",
      "argv": [
        "C:\\a\"b.exe",
        "x"
      ],
      "target_kind": "exe",
      "expected_error": "program name may not contain '\"' or NUL",
      "notes": "argv0 has no escape mechanism; Windows file names cannot contain '\"'."
    },
    {
      "name": "exe_reject_empty_program",
      "argv": [
        "",
        "x"
      ],
      "target_kind": "exe",
      "expected_error": "empty program name",
      "notes": "No program."
    },
    {
      "name": "exe_reject_too_long",
      "argv": [
        "C:\\tools\\echoargs.exe",
        "<generated>"
      ],
      "target_kind": "exe",
      "argv_generator": {
        "index": 1,
        "char": "a",
        "count": 32767
      },
      "expected_error": "command line exceeds 32767 UTF-16 units",
      "notes": "Command line > 32,767 UTF-16 units (CreateProcessW limit). Use a response file (@file) if the tool supports it."
    },
    {
      "name": "exe_reject_invalid_utf8",
      "argv": [
        "C:\\tools\\echoargs.exe",
        "<bytes>"
      ],
      "target_kind": "exe",
      "argv_hex": [
        null,
        "fffe"
      ],
      "expected_error": "argument is not valid UTF-8",
      "notes": "Interpreter strings are bytes; bytes that are not valid UTF-8 (here 0xFF 0xFE) cannot be converted to UTF-16 without loss -> error (do not lossy-replace with U+FFFD)."
    },
    {
      "name": "bat_reject_newline",
      "argv": [
        "C:\\tools\\shim.bat",
        "a\nb"
      ],
      "target_kind": "bat",
      "expected_error": "CR/LF in batch argument",
      "notes": "LF terminates the cmd.exe command; would truncate/inject. Rust std also rejects."
    },
    {
      "name": "bat_reject_cr",
      "argv": [
        "C:\\tools\\shim.bat",
        "a\rb"
      ],
      "target_kind": "bat",
      "expected_error": "CR/LF in batch argument",
      "notes": "CR rejected (Rust std)."
    },
    {
      "name": "bat_reject_quote_in_script",
      "argv": [
        "C:\\x\"y.bat",
        "a"
      ],
      "target_kind": "bat",
      "expected_error": "Windows file names may not contain '\"' or end with '\\'",
      "notes": "Script name may not contain '\"'."
    },
    {
      "name": "bat_reject_trailing_backslash_script",
      "argv": [
        "C:\\dir\\",
        "a"
      ],
      "target_kind": "bat",
      "expected_error": "Windows file names may not contain '\"' or end with '\\'",
      "notes": "Script name may not end with '\\'."
    },
    {
      "name": "bat_reject_too_long",
      "argv": [
        "C:\\tools\\shim.bat",
        "<generated>"
      ],
      "target_kind": "bat",
      "argv_generator": {
        "index": 1,
        "char": "a",
        "count": 8200
      },
      "expected_error": "command line exceeds cmd.exe 8191-char limit",
      "notes": "cmd.exe command line limit is 8191 chars."
    }
  ]
}